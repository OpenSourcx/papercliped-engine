{
  "listen": { "host": "127.0.0.1", "port": 8787 },
  "proxmox": {
    "url": "https://127.0.0.1:8006",
    "node": "pve",
    "tokenId": "engine-broker@pve!engine",
    "caFile": "/etc/pve/pve-root-ca.pem"
  },
  "protectedVmids": [],
  "profiles": {
    "debian-small": {
      "ostemplate": "local:vztmpl/debian-13-standard_13.1-1_amd64.tar.zst",
      "storage": "local",
      "bridge": "vmbr0",
      "cores": 2,
      "memoryMb": 2048,
      "diskGb": 8
    }
  },
  "groups": {
    "acme": {
      "pool": "co-acme",
      "tag": "co-acme",
      "vmidRange": [9000, 9049],
      "profiles": ["debian-small"],
      "limits": { "maxLeases": 4, "maxCores": 8, "maxMemoryMb": 8192, "maxTtlMinutes": 240, "defaultTtlMinutes": 120 }
    }
  },
  "principals": [
    { "name": "pin", "scope": "system", "tokenSha256": "replace-with-64-hex-sha256-of-pin-token" },
    { "name": "acme-agents", "scope": "group", "group": "acme", "tokenSha256": "replace-with-64-hex-sha256-of-acme-token" }
  ],
  "auditLog": "/var/log/papercliped/broker-audit.jsonl"
}
