#!/usr/bin/env bash
# Test stand-in: `id -u` says root (the installer insists on it); `id <name>` knows only the users the useradd stand-in
# recorded. Anything else goes to the real id.
case "${1:-}" in
  -u) [ "$#" -eq 1 ] && { echo 0; exit 0; }; exec /usr/bin/id "$@" ;;
  -*|"") exec /usr/bin/id "$@" ;;
  *) grep -qx "$1" "${STUB_STATE:?}/users" 2>/dev/null && { echo "uid=999($1) gid=999($1) groups=999($1)"; exit 0; }
     echo "id: '$1': no such user" >&2; exit 1 ;;
esac
