[Unit]
Description=ePaperclip console and host service
Documentation=https://github.com/OpenSourcx/papercliped-engine
After=network-online.target pve-cluster.service pveproxy.service epaperclip-engine.service
Wants=network-online.target epaperclip-engine.service
Requires=pve-cluster.service

[Service]
Type=simple
User=epaperclip
Group=epaperclip
# Read access to the node certificate, its key and the cluster CA in /etc/pve, the same way pveproxy reads them.
SupplementaryGroups=www-data
# The engine (epaperclip-engine.service) on loopback, and where it is installed (read for its version).
Environment=EPC_STATE_DIR=/var/lib/epaperclip EPC_ENGINE_DIR=/opt/epaperclip/engine
Environment=EPC_ENGINE_URL=http://127.0.0.1:3100 EPC_ENGINE_PUBLIC_URL=http://127.0.0.1:3100
EnvironmentFile=-/etc/default/epaperclip
ExecStart=/opt/epaperclip/node/bin/node /opt/epaperclip/epaperclip.mjs
# Its vault key and settings (every secret in them encrypted by the vault).
StateDirectory=epaperclip
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3

# Port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# It serves files, talks to Proxmox and the engine on loopback, keeps sessions in memory and writes only its state
# directory: lock everything else down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
MemoryMax=512M

[Install]
WantedBy=multi-user.target
